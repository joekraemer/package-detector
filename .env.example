# Copy to .env for local runs. On the fleet host this lives in
# ~/.config/fleet/package-detector.env instead. Never commit .env.

# name=rtsp-url pairs, comma separated. Reolink: use the sub-stream.
# Names: lowercase letters, digits, _ (they become binary_sensor.package_<name>).
# Older firmware: /h264Preview_01_sub   Newer: /Preview_01_sub
CAMERAS=doorbell=rtsp://admin:PASSWORD@192.168.1.20:554/h264Preview_01_sub,garage=rtsp://admin:PASSWORD@192.168.1.21:554/h264Preview_01_sub

# Seconds between polls (15..900). 15 = every 15 seconds. loop.py uses
# this as its sleep, so it is the only interval to set.
# Note: loop.py sleeps this long AFTER a poll finishes, so the real
# period is poll duration + this number, not a strict cadence.
POLL_INTERVAL_SECONDS=15

# ONNX model, mounted, not committed. The zone classifier from train.py
# is package-cls.onnx plus its package-cls.json sidecar (classes, input
# size and the zone per camera it was trained on); cameras not in the
# sidecar are skipped. Without a sidecar the file is a YOLO box detector.
MODEL_PATH=/models/package-cls.onnx
# Confidence bar, 0..1 (classifier: p(package)).
CONFIDENCE=0.5
# 1 = shadow mode: full loop and SQLite, but never call Home Assistant;
# state changes are only logged. Start here, read the log, then set 0.
HA_DRY_RUN=1
# Consecutive polls to confirm present / clear absent.
# At 15 s polls: present ~30 s after the first detection,
# absent ~75 s after the last detection.
CONFIRM_HITS=2
CLEAR_MISSES=5

# Per-camera zone, x_min,y_min,x_max,y_max as fractions of the frame.
# Only detections whose centre is inside count. Unset = full frame.
# ZONES=doorbell=0,0.5,1,1,garage=0,0.3,1,1

# Home Assistant. Required for live runs; not needed for --check/--dry-run.
HA_URL=http://homeassistant.local:8123
# Long-lived access token. Secret: fleet env file only, never commit it.
HA_TOKEN=
# Re-send each sensor's current state this often (seconds, 60..3600), and
# after any failed POST. HA forgets REST-set states when it restarts.
HA_REFRESH_SECONDS=300
# Push a phone notification through HA when a package ARRIVES (comma
# separated notify services). Unset = sensor only. Not sent in HA_DRY_RUN.
# HA_NOTIFY=notify.mobile_app_your_phone
# Quiet period after a push for the same camera, seconds (0..86400).
HA_NOTIFY_COOLDOWN_SECONDS=1800

DATA_DIR=/data
SNAPSHOT_TIMEOUT_S=15
TZ=America/Los_Angeles

# ---- capture.py (training-data collection, not the deployed detector) ----
# Where frames + index.jsonl go (fleet: inside the package-capture-data
# volume). Tens of MB per day for two cameras.
CAPTURE_DIR=/data/frames
# camera=binary_sensor pairs that mark a visit: an "arrive" frame when it
# turns on, then frames CAPTURE_AFTER_SECONDS after it turns off.
# Check the exact entity ids with: python capture.py check
# Prefer person sensors: plain motion on the garage camera fired ~800x/day
# on street traffic and kept CAPTURE_MAX_EVENTS_PER_HOUR maxed out.
CAPTURE_TRIGGERS=doorbell=binary_sensor.doorbell_person,garage=binary_sensor.garage_person
CAPTURE_AFTER_SECONDS=30,120
# Baseline frame cadence by sun phase (from HA sun.sun). Twilight = within
# 45 min of sunrise/sunset, when the cameras flip in/out of IR night mode.
CAPTURE_DAY_MINUTES=20
CAPTURE_NIGHT_MINUTES=60
CAPTURE_TWILIGHT_MINUTES=10
# Per camera, rolling hour. Stops a windy-day motion sensor filling the disk.
CAPTURE_MAX_EVENTS_PER_HOUR=12
CAPTURE_MIN_FREE_GB=5
